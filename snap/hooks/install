#!/bin/bash -e

. "$SNAP/k8s/lib.sh"

k8s::common::setup_env

# copies resources that can be used as templates for snap users.
k8s::common::resources

# disable snap set/get on startup as k8sd is not up yet.
# the sync will be enabled in the bootstrap hook.
k8s::cmd::k8s x-snapd-config disable || true

# k8s has a REST interface to initialize a cluster.
# In order to interact with the REST API the k8sd service
# needs to be started and configured in the installation step.
k8s::init::k8sd || true

if k8s::common::is_strict; then
  # Ensure the bind/bind-file layout sources exist (see snap/snapcraft.yaml).
  mkdir -p \
    "$SNAP_COMMON/var/lib/kubelet" \
    "$SNAP_COMMON/var/lib/cni" \
    "$SNAP_COMMON/kube-proxy" \
    "$SNAP_COMMON/opt/cni/bin" \
    "$SNAP_COMMON/usr/libexec" \
    "$SNAP_COMMON/usr/local/lib" \
    "$SNAP_COMMON/var/log/pods" \
    "$SNAP_COMMON/var/log/containers" \
    "$SNAP_COMMON/etc"
  touch "$SNAP_COMMON/etc/nanorc"
fi
