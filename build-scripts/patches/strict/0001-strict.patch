+confinement: strict
+assumes: [snapd2.62]
 # Note(ben): Snapcraft does not expose its base for part builds, so we need to set it manually.
 # Feature request tracked in https://github.com/canonical/snapcraft/issues/5614
 # For now, remember to also update OPENSSL_MODULES and etcd part BASE when bumping this version.
@@ -16,9 +17,16 @@ environment:
   REAL_PATH: $PATH
   REAL_LD_LIBRARY_PATH: $LD_LIBRARY_PATH
   CRAFT_ARCH_TRIPLET_BUILD_FOR: $CRAFT_ARCH_TRIPLET_BUILD_FOR
-  # Note(ben): Needs to be changed to /snap/core24/current/usr/lib/x86_64-linux-gnu/ossl-modules/
-  # when base is updated to core24 (mind the removed "-3").
-  OPENSSL_MODULES: /snap/core22/current/usr/lib/$CRAFT_ARCH_TRIPLET_BUILD_FOR/ossl-modules-3/
+  # Under strict confinement the base snap is the rootfs, so the OpenSSL
+  # modules are at their standard base path.
+  OPENSSL_MODULES: /usr/lib/$CRAFT_ARCH_TRIPLET_BUILD_FOR/ossl-modules-3/
+  # nano is staged in the snap; set it as the editor so 'kubectl edit' works
+  EDITOR: $SNAP/bin/nano
+  # Override snapd's default PATH: /usr/sbin and /usr/games are not listable
+  # under the generated AppArmor profiles, and kubectl's plugin discovery
+  # probes every PATH entry (harmless but noisy denials). apparmor_parser
+  # resolves via the /sbin -> usr/sbin symlink instead.
+  PATH: $SNAP/usr/sbin:$SNAP/usr/bin:$SNAP/sbin:$SNAP/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin
 
 architectures:
   - build-on: [amd64]
@@ -26,12 +34,87 @@ architectures:
   - build-on: [ppc64el]
   - build-on: [s390x]
 
+# Custom interface plugs. Super-privileged interfaces (docker-support,
+# system-files, home read:all, kernel-module-load) require a store
+# snap-declaration; see docs/canonicalk8s/snap/explanation/security.md.
+plugs:
+  home-read-all:
+    interface: home
+    read: all
+  docker-privileged:
+    interface: docker-support
+    privileged-containers: true
+  docker-unprivileged:
+    interface: docker-support
+    privileged-containers: false
+  k8s-kubeproxy:
+    interface: kubernetes-support
+    flavor: kubeproxy
+  cilium-module-load:
+    interface: kernel-module-load
+    modules:
+      - name: iptable_raw
+        load: on-boot
+      - name: xt_socket
+        load: on-boot
+  # Host-visible Kubernetes configuration and CNI config (compliance contract).
+  # Written by k8sd. Exact paths only: system-files rejects globs.
+  k8s-etc:
+    interface: system-files
+    write:
+      - /etc/kubernetes
+      # /etc/cni itself must be writable so k8sd can MkdirAll(/etc/cni/net.d):
+      # creating the parent is a write to /etc/cni, not to /etc/cni/net.d.
+      - /etc/cni
+  # Read-only access to the same host paths for the services that consume
+  # kubeconfigs, PKI and CNI configuration.
+  k8s-etc-ro:
+    interface: system-files
+    read:
+      - /etc/kubernetes
+      - /etc/cni/net.d
+  # Persisted sysctl settings (written by the configure hook,
+  # k8s::util::apply_sysctl_tuning). Exact path, must stay in sync with
+  # k8s/lib.sh.
+  k8s-sysctl:
+    interface: system-files
+    write:
+      - /etc/sysctl.d/1000-cilium.conf
+  # Kubernetes audit log, asserted from the host by compliance docs/tests.
+  k8s-audit-log:
+    interface: system-files
+    write:
+      - /var/log/kubernetes
+
+# Relocate paths that are owned by the base snap under strict confinement.
+# /etc, /run and /var/log are host-visible and are covered by interface
+# grants instead; /run is not a legal layout target.
+layout:
+  /var/lib/kubelet:
+    bind: $SNAP_COMMON/var/lib/kubelet
+  /var/lib/cni:
+    bind: $SNAP_COMMON/var/lib/cni
+  /var/lib/kube-proxy:
+    bind: $SNAP_COMMON/kube-proxy
+  /opt/cni/bin:
+    bind: $SNAP_COMMON/opt/cni/bin
+  /usr/libexec:
+    bind: $SNAP_COMMON/usr/libexec
+  /usr/local/lib:
+    bind: $SNAP_COMMON/usr/local/lib
+  /var/log/pods:
+    bind: $SNAP_COMMON/var/log/pods
+  /var/log/containers:
+    bind: $SNAP_COMMON/var/log/containers
+  /etc/nanorc:
+    bind-file: $SNAP_COMMON/etc/nanorc
+
