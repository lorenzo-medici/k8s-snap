#!/bin/bash -e

. "$SNAP/k8s/lib.sh"

k8s::common::setup_env

# Ensure XDG_RUNTIME_DIR exists, needed by runc for 'kubectl exec' to work
[ ! -z "${XDG_RUNTIME_DIR:=}" ] && mkdir -p "${XDG_RUNTIME_DIR}"

# Apply apparmor profile for "cri-containerd.apparmor.d"
# (absolute path: /sbin is a symlink to usr/sbin on merged-usr, and under
# strict confinement PATH deliberately excludes both to avoid AppArmor
# directory-list denials from kubectl's plugin discovery)
if ! /usr/sbin/apparmor_parser -r "$SNAP/k8s/profiles/containerd"; then
  echo "

WARNING: Failed to configure the 'cri-containerd.apparmor.d' AppArmor profile.

This might affect container shim management (e.g. pods failing to delete).
You can try to apply the profile manually by running:

    apparmor_parser -r '${SNAP}/k8s/profiles/containerd'

"
fi

if k8s::common::is_strict; then
  # Mirror the classic systemd drop-in (k8s/systemd/containerd-defaults.conf):
  # - Delegate=yes comes from the docker-support interface under strict
  # - the Limit* values become ulimits here (best-effort)
  # - OOMScoreAdjust becomes a /proc/self/oom_score_adj write
  # - TasksMax has no strict equivalent (tracked as a porting requirement)
  ulimit -n unlimited 2>/dev/null || ulimit -n 65536 || true
  ulimit -u unlimited 2>/dev/null || true
  ulimit -c unlimited 2>/dev/null || true
  echo -999 > /proc/self/oom_score_adj 2>/dev/null || true
else
  # Re-exec outside of apparmor confinement
  if [ -d /sys/kernel/security/apparmor ] && [ "$(cat /proc/self/attr/current)" != "unconfined" ]; then
      exec aa-exec -p unconfined -- "$0" "$@"
  fi
fi

k8s::common::execute containerd
